# ── Telegram Bot ──────────────────────────────────────────────────────────────

# Your BotFather token (required for both bot.py and ticket_miniapp.py)
BOT_TOKEN=your_bot_token_here

# Telegram group chat ID where tickets are posted by the bot
# (usually a negative number, e.g. -1001234567890)
LOG_CHAT_ID=-1001234567890

# ── Locale / Timezone ─────────────────────────────────────────────────────────

# IANA timezone name used for all local timestamps in reports and the web UI
TZ=Asia/Phnom_Penh

# ── Web API (ticket_miniapp.py) ───────────────────────────────────────────────

# Host and port for the FastAPI server
API_HOST=0.0.0.0
API_PORT=8001

# ── Organization config (comma-separated, no quotes) ─────────────────────────
# These are injected as the selectable options in the ticket wizard and web UI.

BRANCHES=Head Office,Branch A,Branch B
DEPARTMENTS=IT,HR,Finance,Sales,Marketing,Admin
CATEGORIES=Internet/WiFi,Computer,Printer,Software,CCTV,Other

# ── IT Admin access ───────────────────────────────────────────────────────────
# Comma-separated Telegram user IDs with admin privileges
IT_USER_IDS=123456789,987654321

# Comma-separated Telegram usernames (lowercase, no @) with admin privileges
IT_USERNAMES=adminuser1,adminuser2
