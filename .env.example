# Copy this to .env and fill in your values.
# Never commit .env — it is listed in .gitignore.

# Your BotFather token. Required for both bot.py and ticket_miniapp.py.
BOT_TOKEN=your_bot_token_here

# Telegram group chat ID where new ticket posts appear.
# This is usually a negative number, e.g. -1001234567890.
# Get it by adding @userinfobot to the group and sending any message.
LOG_CHAT_ID=-1001234567890

# IANA timezone for all local timestamps in the UI and exports.
TZ=Asia/Phnom_Penh

# Host and port for the FastAPI web server (ticket_miniapp.py).
API_HOST=0.0.0.0
API_PORT=8001

# Comma-separated list of your organisation's locations/properties.
# These appear as options in the bot wizard and the web UI form.
BRANCHES=Head Office,Branch A,Branch B,Other

# Comma-separated list of departments.
DEPARTMENTS=IT,HR,Finance,Sales,Marketing,Admin

# Comma-separated list of issue categories.
CATEGORIES=Internet/WiFi,Computer,Printer,Software,CCTV,Other

# Comma-separated Telegram user IDs that have IT admin access.
# IT admins can close, reassign, delete, and export tickets.
IT_USER_IDS=123456789,987654321

# Comma-separated Telegram usernames (lowercase, no @) with IT admin access.
IT_USERNAMES=itadmin,helpdeskteam
